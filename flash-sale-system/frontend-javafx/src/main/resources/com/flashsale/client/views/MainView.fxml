<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefWidth="1100" prefHeight="760" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.flashsale.client.controllers.MainController">
    <!-- Top Minimalist Navigation (Like Reference HOME DECOR) -->
    <top>
        <VBox>
            <HBox alignment="CENTER" styleClass="nav-header">
                <!-- Left Nav Links Removed -->
                
                <Region HBox.hgrow="ALWAYS" />

                <!-- Center Minimalist Brand Logo -->
                <Label text="FLASH SALE" styleClass="brand-logo" />

                <Region HBox.hgrow="ALWAYS" />

                <!-- Right System Status Badges -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Label fx:id="userBadgeLabel" text="👤 Admin" styleClass="user-pill" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- Main Tab Content -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="tab-pane">
            <!-- TAB 1: LUXURY SHOPPER STOREFRONT -->
            <Tab text="Shop &amp; Live Drops">
                <HBox spacing="28" style="-fx-padding: 24px 36px;">
                    <!-- LEFT & CENTER: Product Showcase (Matches Left of Reference) -->
                    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;">
                        <VBox spacing="24">
                            <HBox spacing="32">
                                <!-- Product Hero Visual Card -->
                                <VBox prefWidth="360" minWidth="340" spacing="16">
                                    <VBox prefHeight="380" styleClass="product-hero-card">
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label text="⚡" styleClass="hero-product-icon" />
                                        <Label fx:id="heroProductSubtitle" text="PREMIUM LIMITED DROP" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #9CA3AF; -fx-letter-spacing: 2px;" />
                                        <Region VBox.vgrow="ALWAYS" />
                                    </VBox>

                                    <!-- Switchable Drops Selector (Clean List without 1990s empty rows) -->
                                    <VBox spacing="8">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Active Drops:" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #71717A;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Button text="↻ Refresh" onAction="#handleRefreshSales" style="-fx-background-color: transparent; -fx-text-fill: #059669; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" />
                                        </HBox>
                                        <ListView fx:id="salesListView" prefHeight="95" styleClass="list-view" />
                                    </VBox>
                                </VBox>

                                <!-- Product Details & Purchase Form -->
                                <VBox spacing="14" HBox.hgrow="ALWAYS">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="LIVE DROP" styleClass="badge-new" />
                                    </HBox>

                                    <Label fx:id="selectedSaleTitleLabel" text="Limited Edition Gaming Console" styleClass="product-title" wrapText="true" />

                                    <HBox spacing="12" alignment="BASELINE_LEFT">
                                        <Label fx:id="selectedSalePriceLabel" text="₹49,999.00" styleClass="product-price" />
                                    </HBox>

                                    <!-- Live Inventory Conservation Progress Bar -->
                                    <VBox spacing="6" styleClass="stock-bar-container">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="LIVE INVENTORY:" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #71717A;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="remainingStockBadge" text="14 units available" style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #DC2626;" />
                                        </HBox>
                                        <ProgressBar fx:id="stockLevelProgressBar" progress="0.14" maxWidth="Infinity" styleClass="stock-progress" prefHeight="8" />
                                        <Label fx:id="stockBreakdownLabel" text="Total: 100 | Sold: 86 | Reserved: 0" style="-fx-font-size: 11px; -fx-text-fill: #A1A1AA;" />
                                    </VBox>



                                    <!-- Minimalist Stepper & Buy Action Buttons (Exact Match to Reference Mockup) -->
                                    <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 8px 0;">
                                        <!-- Pill Stepper ( - 1 + ) -->
                                        <HBox alignment="CENTER" styleClass="stepper-pill">
                                            <Button text="-" onAction="#handleDecrementQuantity" styleClass="btn-stepper" />
                                            <TextField fx:id="quantityField" text="1" prefWidth="42" styleClass="input-stepper" />
                                            <Button text="+" onAction="#handleIncrementQuantity" styleClass="btn-stepper" />
                                        </HBox>

                                        <!-- Buy Now / Reserve Pill Button -->
                                        <Button fx:id="reserveButton" text="⚡ Reserve Now (Lock Stock)" onAction="#handleReserveStock" styleClass="btn-pill-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                    </HBox>

                                    <!-- Live Distributed Execution Pipeline Stepper -->
                                    <VBox spacing="8" styleClass="pipeline-card">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="⚡ Architecture Execution Pipeline (Live Stage Timing)" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #52525B;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="pipelineTotalTimeLabel" text="Idle" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #71717A;" />
                                        </HBox>
                                        <HBox spacing="6" alignment="CENTER">
                                            <!-- Step 1: Rate Limiter -->
                                            <VBox HBox.hgrow="ALWAYS" styleClass="pipeline-node" fx:id="pipelineNode1">
                                                <Label text="1. Rate Limiter" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #71717A;" />
                                                <Label fx:id="pipelineStep1Label" text="⚪ Idle" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #18181B;" />
                                            </VBox>
                                            <Label text="➔" style="-fx-text-fill: #A1A1AA; -fx-font-weight: bold;" />
                                            <!-- Step 2: Redis Lua Gate -->
                                            <VBox HBox.hgrow="ALWAYS" styleClass="pipeline-node" fx:id="pipelineNode2">
                                                <Label text="2. Redis Lua Gate" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #71717A;" />
                                                <Label fx:id="pipelineStep2Label" text="⚪ Idle" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #18181B;" />
                                            </VBox>
                                            <Label text="➔" style="-fx-text-fill: #A1A1AA; -fx-font-weight: bold;" />
                                            <!-- Step 3: PostgreSQL Ledger -->
                                            <VBox HBox.hgrow="ALWAYS" styleClass="pipeline-node" fx:id="pipelineNode3">
                                                <Label text="3. PostgreSQL Ledger" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #71717A;" />
                                                <Label fx:id="pipelineStep3Label" text="⚪ Idle" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #18181B;" />
                                            </VBox>
                                            <Label text="➔" style="-fx-text-fill: #A1A1AA; -fx-font-weight: bold;" />
                                            <!-- Step 4: 60s Hold Window -->
                                            <VBox HBox.hgrow="ALWAYS" styleClass="pipeline-node" fx:id="pipelineNode4">
                                                <Label text="4. 60s Hold Window" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #71717A;" />
                                                <Label fx:id="pipelineStep4Label" text="⚪ Idle" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #18181B;" />
                                            </VBox>
                                        </HBox>
                                    </VBox>


                                </VBox>
                            </HBox>


                        </VBox>
                    </ScrollPane>

                    <!-- RIGHT COLUMN: Slide-Out Cart & Hold Drawer (Exact Match to Reference Cart Drawer) -->
                    <VBox prefWidth="350" minWidth="330" spacing="18" styleClass="cart-drawer">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Cart &amp; Hold" styleClass="cart-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="⚡ Active Drop" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #71717A;" />
                        </HBox>

                        <!-- Amber Hold Notice (Like reference 'It's in the bag. We'll hold it for an hour') -->
                        <VBox spacing="8" styleClass="hold-banner">
                            <Label text="⏳ It's in the bag! We'll hold it for 60 seconds." style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #92400E;" wrapText="true" />
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Hold Window:" style="-fx-font-size: 11px; -fx-text-fill: #B45309;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="countdownTimerLabel" text="60s" styleClass="countdown-timer-large" />
                            </HBox>
                            <ProgressBar fx:id="countdownProgressBar" progress="1.0" maxWidth="Infinity" prefHeight="6" style="-fx-accent: #DC2626;" />
                        </VBox>

                        <!-- Cart Reserved Item Card -->
                        <VBox spacing="8" styleClass="cart-item-card">
                            <Label fx:id="cartItemTitle" text="No item reserved yet" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #18181B;" wrapText="true" />
                            <Label fx:id="reservationInfoLabel" text="Click 'Reserve Now' to lock stock." style="-fx-font-size: 11px; -fx-text-fill: #71717A;" wrapText="true" />
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Total & Checkout Action -->
                        <VBox spacing="14">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Total" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #18181B;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="cartTotalLabel" text="₹0.00" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #18181B;" />
                            </HBox>

                            <Button fx:id="payButton" text="Complete Checkout" onAction="#handlePayOrder" maxWidth="Infinity" disable="true" styleClass="btn-pill-primary" />

                            <Label fx:id="checkoutResultLabel" text="Ready" style="-fx-font-size: 12px; -fx-text-fill: #71717A; -fx-alignment: center;" wrapText="true" maxWidth="Infinity" />
                        </VBox>
                    </VBox>
                </HBox>
            </Tab>

            <!-- TAB 2: CONCURRENCY BENCHMARK STUDIO -->
            <Tab text="Concurrency Studio">
                <VBox spacing="16" style="-fx-padding: 20px 36px;">
                    <!-- Configuration Bar (Simplified & Contextualized) -->
                    <VBox spacing="14" styleClass="sim-card">
                        <!-- Top Row: Target Drop, Traffic Burst & Checkout Behavior -->
                        <HBox spacing="18" alignment="CENTER_LEFT">
                            <!-- Dropdown for Target Flash Sale -->
                            <VBox spacing="4" prefWidth="250">
                                <Label text="Target Flash Sale Drop:" styleClass="sim-stat-title" />
                                <ComboBox fx:id="simSaleComboBox" prefWidth="250" promptText="Select Active Drop..." />
                            </VBox>

                            <!-- Single Unified Shoppers Control -->
                            <VBox spacing="4" prefWidth="230">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Simultaneous Shoppers:" styleClass="sim-stat-title" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox spacing="4">
                                        <Button text="50" onAction="#handleSetShoppers50" styleClass="btn-preset" />
                                        <Button text="250" onAction="#handleSetShoppers250" styleClass="btn-preset" />
                                        <Button text="1k" onAction="#handleSetShoppers1000" styleClass="btn-preset" />
                                    </HBox>
                                </HBox>
                                <TextField fx:id="simShoppersField" text="100" promptText="e.g. 100" />
                            </VBox>

                            <!-- Checkout Behavior / Conversion Slider -->
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Checkout Conversion:" styleClass="sim-stat-title" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="simRateLabel" text="100% (Instant Pay - Normal Shoppers)" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #059669;" />
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Slider fx:id="simRateSlider" min="0" max="100" value="100" HBox.hgrow="ALWAYS" />
                                    <Button text="100%" onAction="#handleSetPay100" styleClass="btn-preset" />
                                    <Button text="50%" onAction="#handleSetPay50" styleClass="btn-preset" />
                                    <Button text="0%" onAction="#handleSetPay0" styleClass="btn-preset" />
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- Bottom Row: Architecture Engine Mode & Launch Button -->
                        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-border-color: #F4F4F5; -fx-border-width: 1 0 0 0; -fx-padding: 8px 0 0 0;">
                            <Label text="Architecture Engine:" styleClass="sim-stat-title" />
                            <fx:define>
                                <ToggleGroup fx:id="engineToggleGroup" />
                            </fx:define>
                            <RadioButton fx:id="radioRedisLua" text="⚡ Redis Lua (In-Memory Atomic)" toggleGroup="$engineToggleGroup" selected="true" styleClass="engine-radio" />
                            <RadioButton fx:id="radioDirectDb" text="🗄️ Direct PostgreSQL (Row Lock)" toggleGroup="$engineToggleGroup" styleClass="engine-radio" />

                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="runSimButton" text="🔥 Launch Redis Lua Burst" onAction="#handleRunSimulation" styleClass="btn-pill-primary" />
                        </HBox>
                    </VBox>

                    <!-- Real-Time Metrics Grid -->
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="20" />
                            <ColumnConstraints percentWidth="20" />
                            <ColumnConstraints percentWidth="20" />
                            <ColumnConstraints percentWidth="20" />
                            <ColumnConstraints percentWidth="20" />
                        </columnConstraints>
                        
                        <VBox GridPane.columnIndex="0" styleClass="sim-stat-box">
                            <Label text="TOTAL REQUESTS" styleClass="sim-stat-title" />
                            <Label fx:id="simTotalLabel" text="--" styleClass="sim-stat-num" />
                        </VBox>
                        
                        <VBox GridPane.columnIndex="1" styleClass="sim-stat-box" style="-fx-border-color: #10B981; -fx-border-width: 0 0 4 0;">
                            <Label text="SUCCESS (ADMITTED)" styleClass="sim-stat-title" style="-fx-text-fill: #059669;" />
                            <Label fx:id="simSuccessLabel" text="--" styleClass="sim-stat-num" style="-fx-text-fill: #059669;" />
                        </VBox>

                        <VBox GridPane.columnIndex="2" styleClass="sim-stat-box" style="-fx-border-color: #EF4444; -fx-border-width: 0 0 4 0;">
                            <Label text="REJECTED (NO STOCK)" styleClass="sim-stat-title" style="-fx-text-fill: #DC2626;" />
                            <Label fx:id="simRejectedLabel" text="--" styleClass="sim-stat-num" style="-fx-text-fill: #DC2626;" />
                        </VBox>

                        <VBox GridPane.columnIndex="3" styleClass="sim-stat-box">
                            <Label text="THROUGHPUT (REQ/S)" styleClass="sim-stat-title" />
                            <Label fx:id="simThroughputLabel" text="--" styleClass="sim-stat-num" style="-fx-text-fill: #2563EB;" />
                        </VBox>

                        <VBox GridPane.columnIndex="4" styleClass="sim-stat-box">
                            <Label text="LATENCY / DURATION" styleClass="sim-stat-title" />
                            <Label fx:id="simDurationLabel" text="--" styleClass="sim-stat-num" />
                        </VBox>
                    </GridPane>

                    <!-- Database Blast Shield & Resource Protection Status Banner -->
                    <HBox spacing="18" alignment="CENTER_LEFT" styleClass="blast-shield-card">
                        <Label text="🛡️ DB BLAST SHIELD" style="-fx-font-weight: 800; -fx-font-size: 11px; -fx-text-fill: #1E293B; -fx-background-color: #E2E8F0; -fx-padding: 4px 8px; -fx-background-radius: 4px;" />
                        <Label fx:id="dbQueriesLabel" text="PostgreSQL Queries: --" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #2563EB;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="dbShieldedLabel" text="Database Load Shielded: --" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #059669;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="dbPoolStatusLabel" text="HikariCP Pool Pressure: --" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #64748B;" />
                    </HBox>

                    <!-- Real-Time Activity Terminal -->
                    <VBox VBox.vgrow="ALWAYS" styleClass="sim-terminal" spacing="8">
                        <Label text="Distributed Transaction &amp; Architectural Comparison Log" style="-fx-text-fill: #F59E0B; -fx-font-size: 12px; -fx-font-weight: 700;" />
                        <TextArea fx:id="simLogArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="sim-terminal-text" />
                    </VBox>
                </VBox>
            </Tab>

            <!-- TAB 3: ADMIN & INVENTORY -->
            <Tab text="Admin &amp; Inventory">
                <VBox spacing="20" style="-fx-padding: 24px 36px;">
                    <!-- Product Form -->
                    <HBox spacing="18" alignment="CENTER_LEFT" styleClass="sim-card">
                        <Label text="New Product" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <VBox spacing="4">
                            <Label text="Name:" styleClass="sim-stat-title"/>
                            <TextField fx:id="newProductNameField" promptText="Name" />
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Desc:" styleClass="sim-stat-title"/>
                            <TextField fx:id="newProductDescField" promptText="Description" />
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Price:" styleClass="sim-stat-title"/>
                            <TextField fx:id="newProductPriceField" promptText="Price (e.g. 99.99)" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Add Product" onAction="#handleAddProduct" styleClass="btn-pill-primary" />
                    </HBox>
                    <Label fx:id="productResultLabel" text="" style="-fx-text-fill: #059669;" />

                    <!-- Flash Sale Form -->
                    <HBox spacing="18" alignment="CENTER_LEFT" styleClass="sim-card">
                        <Label text="New Flash Sale" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <VBox spacing="4">
                            <Label text="Product ID:" styleClass="sim-stat-title"/>
                            <TextField fx:id="newSaleProductIdField" promptText="Product ID" prefWidth="80"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Stock:" styleClass="sim-stat-title"/>
                            <TextField fx:id="newSaleStockField" promptText="Stock Quantity" prefWidth="100"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Max/User:" styleClass="sim-stat-title"/>
                            <TextField fx:id="newSaleMaxQtyField" promptText="e.g. 1" prefWidth="70"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Create Sale" onAction="#handleAddSale" styleClass="btn-pill-primary" />
                    </HBox>
                    <Label fx:id="saleResultLabel" text="" style="-fx-text-fill: #059669;" />
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
